APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Path ke folder bin PostgreSQL (pg_dump, psql). Sesuaikan per mesin.
# Kosongkan jika pg_dump sudah ada di PATH sistem (misal: server Linux).
# Contoh Windows Laragon : PG_DUMP_BINARY_PATH=D:\laragon\bin\postgresql\postgresql\bin
# Contoh Linux           : PG_DUMP_BINARY_PATH=/usr/bin
PG_DUMP_BINARY_PATH=

# Password Pengaman File Backup ZIP
BACKUP_ARCHIVE_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


#S3 config
FILESYSTEM_DISK=local

# AWS / S3 tidak perlu diisi di lokal
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================
# OCTANE (FrankenPHP di production/staging)
# ==========================================
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

# ==========================================
# MINIO — Internal S3 Storage (s3_local disk)
# Gunakan untuk file besar internal: foto presensi, backup, dll.
# ==========================================
LOCAL_AWS_ACCESS_KEY_ID=minioadmin
LOCAL_AWS_SECRET_ACCESS_KEY=minioadmin
LOCAL_AWS_DEFAULT_REGION=us-east-1
LOCAL_AWS_BUCKET=portal-sma
LOCAL_AWS_URL=http://127.0.0.1:9000
LOCAL_AWS_ENDPOINT=http://127.0.0.1:9000
LOCAL_AWS_USE_PATH_STYLE_ENDPOINT=true

# ==========================================
# CBT ANALYTICS BUCKET (s3_cbt_analytics disk)
# Khusus untuk hasil analisis IRT/CTT dari microservice Python.
# Gunakan bucket BERBEDA dari LOCAL_AWS_BUCKET agar mudah dikelola.
# ==========================================
CBT_ANALYTICS_BUCKET=cbt-analytics
ANALYTICS_DISK=s3_cbt_analytics

# ==========================================
# KONFIGURASI PYTHON IRT MICROSERVICE
# ==========================================
# URL endpoint Microservice Uvicorn
IRT_MICROSERVICE_URL=http://127.0.0.1:8085/api/v1/irt/estimate

# Token keamanan internal — WAJIB sama di Laravel dan microservice Python.
# Gunakan string acak minimal 32 karakter! Jangan gunakan nilai default.
# Generate contoh: python -c "import secrets; print(secrets.token_hex(32))"
CBT_INTERNAL_SECRET=

# Jumlah minimal siswa untuk memicu kalkulasi IRT (Default: 100)
CBT_IRT_MIN_PARTICIPANTS=100
